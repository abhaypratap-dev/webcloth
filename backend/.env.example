# --- Django core ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
# CSRF_TRUSTED_ORIGINS: required once the Django admin is reached through a
# custom domain / Azure host over HTTPS. Include scheme, e.g.:
# https://cutcult-api.azurewebsites.net
CSRF_TRUSTED_ORIGINS=

# --- Database (PostgreSQL) ---
POSTGRES_DB=cutcult
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# "prefer" locally; set to "require" for Azure Database for PostgreSQL.
POSTGRES_SSLMODE=prefer

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- CORS / frontend ---
# Must include the deployed frontend origin(s), e.g.
# https://cutcult.azurestaticapps.net
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
FRONTEND_URL=http://localhost:8080

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Cut & Cult <no-reply@cutcult.local>

# --- Payments ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Media storage (optional; falls back to local disk when unset) ---
# Required in production on Azure App Service, whose local disk is not
# persistent across deploys/restarts/scale-out.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=media
