# --- Cut & Cult storefront ---
# The Django API. No trailing slash after /api.
VITE_API_URL="https://api.example.com/api"

# Which brand this deployment serves. One API serves every brand and holds each
# in its own database, so a request without this is answered with a 404.
VITE_TENANT_SLUG="cutcult"

# Absolute origin of THIS storefront, for og:/twitter: image URLs.
VITE_SITE_URL="https://cutcult.example.com"
