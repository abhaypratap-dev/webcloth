+		const host = parsed.host || req.headers["x-forwarded-host"] || req.headers.host || "localhost";
+		const proto = (parsed.protocol || "https:").replace(/:$/, "");
+		href = `${proto}://${host}${parsed.pathname}${parsed.search}`;
+	} else {
+		const host = req.headers["x-forwarded-host"] || req.headers.host || "localhost";
+		const proto = req.headers["x-forwarded-proto"] || "https";
+		href = `${proto}://${host}/api/${req.params.url || ""}`;
+	}
+	const method = (req.method || "GET").toUpperCase();
